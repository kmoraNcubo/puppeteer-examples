<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Sketch.Forgetting</RootNamespace>
    <AssemblyName>Forgetting</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\actor\SketchActor.csproj" />
    <ProjectReference Include="..\view\SketchView.csproj" />
  </ItemGroup>

  <!--
    Records which engine commit this lab was built against, so every run's
    numbers.json names the engine it measured. Only the short hash is kept.
  -->
  <Target Name="StampEngineCommit" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git -C &quot;$(PuppeteerRoot)&quot; rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="EngineCommit" />
    </Exec>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>EngineCommit</_Parameter1>
        <_Parameter2>$(EngineCommit)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
